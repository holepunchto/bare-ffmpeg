From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bare-ffmpeg <noreply@holepunch.to>
Date: Thu, 20 Nov 2026 00:00:00 +0000
Subject: [PATCH] Route pa_* calls through bare-ffmpeg's dlopen'd pointers

Every pulse source includes pulse_audio_common.h before any code, so this
one include is enough to redirect the whole device. See pulse/pulse-wrap.h.

---
 libavdevice/pulse_audio_common.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libavdevice/pulse_audio_common.h b/libavdevice/pulse_audio_common.h
--- a/libavdevice/pulse_audio_common.h
+++ b/libavdevice/pulse_audio_common.h
@@ -23,6 +23,7 @@
 
 #include <pulse/pulseaudio.h>
 #include "libavcodec/codec_id.h"
+#include "pulse-wrap.h"
 #include "avdevice.h"
 
 pa_sample_format_t ff_codec_id_to_pulse_format(enum AVCodecID codec_id);
