# Writes the libpulse and libasound functions that FFmpeg's pulse and alsa devices call, read from
# libavdevice, as BARE_FFMPEG_LAZY_SYMBOLS(X) with one X(library, symbol) per function, for lazy.c:
#   cmake -D NM=<nm> -D LIBRARY=<libavdevice.a> -D OUTPUT=<lazy-symbols.h> -P cmake/lazy.cmake

execute_process(
  COMMAND "${NM}" -u "${LIBRARY}"
  OUTPUT_VARIABLE undefined
  COMMAND_ERROR_IS_FATAL ANY
)

string(REGEX MATCHALL "[ \t]U (pa|snd)_[A-Za-z0-9_]+" matches "${undefined}")

set(symbols)

foreach(match IN LISTS matches)
  string(REGEX REPLACE "^[ \t]U " "" symbol "${match}")

  list(APPEND symbols ${symbol})
endforeach()

list(REMOVE_DUPLICATES symbols)
list(SORT symbols)

set(content "// Generated by cmake/lazy.cmake from ${LIBRARY}\n\n#define BARE_FFMPEG_LAZY_SYMBOLS(X)")

foreach(symbol IN LISTS symbols)
  if(symbol MATCHES "^pa_")
    set(library pulse)
  else()
    set(library alsa)
  endif()

  string(APPEND content " \\\n  X(${library}, ${symbol})")
endforeach()

string(APPEND content "\n")

file(WRITE "${OUTPUT}.tmp" "${content}")

file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)

file(REMOVE "${OUTPUT}.tmp")
